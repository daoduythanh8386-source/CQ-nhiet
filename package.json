{
  "name": "qc-nhiet-luyen",
  "productName": "QC Nhiệt Luyện",
  "version": "1.0.0",
  "description": "QC Nhiệt Luyện – Oristar",
  "author": "Oristar",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "vn.oristar.qcnhietluyen",
    "productName": "QC Nhiệt Luyện",
    "files": ["electron/**/*"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
